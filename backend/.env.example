# ─────────────────────────────────────────────────────────────
# kAFC — Variables d'environnement
# Copier ce fichier en .env et renseigner chaque valeur.
# ─────────────────────────────────────────────────────────────

# ── SPEECHMATICS ──────────────────────────────────────────────
# Rôle    : Speech-to-Text temps réel + détection de langue + TTS
# Obtenir : https://portal.speechmatics.com/
#           → Créer un compte → API Keys → "Create API Key"
# Format  : chaîne alphanumérique (~40 caractères)
SPEECHMATICS_API_KEY=your_speechmatics_key_here

# ── ANTHROPIC (Claude) ────────────────────────────────────────
# Rôle    : Génération des réponses absurdes du poussin (LLM)
# Obtenir : https://console.anthropic.com/
#           → Créer un compte → API Keys → "Create Key"
# Format  : commence par "sk-ant-..."
ANTHROPIC_API_KEY=your_anthropic_key_here
